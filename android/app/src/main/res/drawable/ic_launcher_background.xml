<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon's background: the same red gradient as the iOS app icon.
  A vector rather than a set of density-bucketed PNGs — minSdk is 26, so every
  supported device draws adaptive icons and there is no legacy bitmap to keep
  in step.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FFE8434F" />
                <item android:offset="1" android:color="#FFC21F2D" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
