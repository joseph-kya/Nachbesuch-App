<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon's foreground: the white house with the red heart from the
  iOS icon.

  All artwork sits inside the centred 66x66 safe zone of the 108x108 adaptive
  canvas, so no launcher mask — circle, squircle or rounded square — clips the
  roof or the door.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft disc behind the house, as on iOS. -->
    <path
        android:pathData="M54,29a25,25 0,1 0,0.1 0z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.10" />

    <!-- Roof. -->
    <path
        android:pathData="M54,33 L80,57 L28,57 Z"
        android:fillColor="#FFFFFF" />

    <!-- Body. -->
    <path
        android:pathData="M33,55 L75,55 L75,74 A4,4 0,0 1,71 78 L37,78 A4,4 0,0 1,33 74 Z"
        android:fillColor="#FFFFFF" />

    <!-- Roof vent. -->
    <path
        android:pathData="M54,42 L60,49 L48,49 Z"
        android:fillColor="#FFE8434F" />

    <!-- Door. -->
    <path
        android:pathData="M39,60 L44,60 A2,2 0,0 1,46 62 L46,78 L37,78 L37,62 A2,2 0,0 1,39 60 Z"
        android:fillColor="#FFEDEDED" />

    <!-- Heart. -->
    <path
        android:pathData="M56,73 C56,73 47,67 47,61.5 C47,58.4 49.3,56.4 51.8,56.4 C53.6,56.4 55.2,57.4 56,58.9 C56.8,57.4 58.4,56.4 60.2,56.4 C62.7,56.4 65,58.4 65,61.5 C65,67 56,73 56,73 Z"
        android:fillColor="#FFD6293A" />
</vector>
